	<sys:String x:Key="String/ApplicationInfoDialog.Website">{0} の Web サイト</sys:String>

	<!-- ApplicationOptions -->
	<sys:String x:Key="String/ApplicationOptions">アプリケーションオプション</sys:String>
	<sys:String x:Key="String/ApplicationOptions.AcceptNonStableApplicationUpdate">プレリリース版の更新を受け取る</sys:String>
	<sys:String x:Key="String/ApplicationOptions.ApplySystemTextScaleFactor">システムの文字サイズを使用する</sys:String>
	<sys:String x:Key="String/ApplicationOptions.ApplySystemTextScaleFactor.Description">システムの文字サイズをユーザーインターフェイスの一部に適用します。</sys:String>
	<sys:String x:Key="String/ApplicationOptions.Culture">言語</sys:String>
	<sys:String x:Key="String/ApplicationOptions.CustomScreenScaleFactor">ユーザーインターフェイスの拡大率</sys:String>
	<sys:String x:Key="String/ApplicationOptions.CustomScreenScaleFactor.XRandRNotFound">XRandR ツールがインストールされていません。</sys:String>
	<sys:String x:Key="String/ApplicationOptions.DefaultBackdropEffectStrength">背景効果</sys:String>
	<sys:String x:Key="String/ApplicationOptions.DefaultScriptLanguage">既定の言語</sys:String>
	<sys:String x:Key="String/ApplicationOptions.DisableAngle">ANGLE レンダリングを無効にする</sys:String>
	<sys:String x:Key="String/ApplicationOptions.DisableAngle.Description">一部のグラフィックスカードで発生する表示の不具合を回避しますが、一部の視覚効果に影響する場合があります。</sys:String>
	<sys:String x:Key="String/ApplicationOptions.EnableLigatureInScript">合字とコンテキスト依存の異体字</sys:String>
	<sys:String x:Key="String/ApplicationOptions.EnableRunningScript">スクリプトの実行を有効にする</sys:String>
	<sys:String x:Key="String/ApplicationOptions.IndentationSizeInScript">インデント幅</sys:String>
	<sys:String x:Key="String/ApplicationOptions.IsUsageDataCollectionAllowed">匿名の使用状況データの収集を許可する</sys:String>
	<sys:String x:Key="String/ApplicationOptions.IsUsageDataCollectionAllowed.Description">アプリケーションの使われ方を把握し、改善に役立てるために使用されます。</sys:String>
	<sys:String x:Key="String/ApplicationOptions.LaunchWithSplashWindow">起動時にスプラッシュ画面を表示する</sys:String>
	<sys:String x:Key="String/ApplicationOptions.LogOutputTargetPort">ログ出力ポート</sys:String>
	<sys:String x:Key="String/ApplicationOptions.NeedToRestartApplicationToTakeEffect">変更を適用するにはアプリケーションを再起動してください。</sys:String>
	<sys:String x:Key="String/ApplicationOptions.NotifyApplicationUpdate">更新が見つかったときに通知する</sys:String>
	<sys:String x:Key="String/ApplicationOptions.Others">その他の設定</sys:String>
	<sys:String x:Key="String/ApplicationOptions.PromptWhenScriptRuntimeErrorOccurred">実行時エラーが発生したときに通知する</sys:String>
	<sys:String x:Key="String/ApplicationOptions.Scripting">スクリプト</sys:String>
	<sys:String x:Key="String/ApplicationOptions.ThemeMode">テーマ</sys:String>
	<sys:String x:Key="String/ApplicationOptions.UserInterface">ユーザーインターフェイス</sys:String>
	<sys:String x:Key="String/ApplicationOptions.UseSpacesForIndentationInScript">インデントにスペースを使用する</sys:String>
	<sys:String x:Key="String/ApplicationOptions.WillCloseAllWindowsToTakeEffect">変更を適用するためにすべてのウィンドウを閉じます。</sys:String>
	<sys:String x:Key="String/ApplicationOptions.WillRestartApplicationToTakeEffect">変更を適用するためにアプリケーションを再起動します。</sys:String>
	<sys:String x:Key="String/ApplicationOptions.WillRestartMainWindowsToTakeEffect">変更を適用するためにウィンドウを再起動します。</sys:String>

	<!-- ApplicationReleasingType -->
	<sys:String x:Key="String/ApplicationReleasingType.Development">開発版</sys:String>
	<sys:String x:Key="String/ApplicationReleasingType.Preview">プレビュー版</sys:String>
	<sys:String x:Key="String/ApplicationReleasingType.ReleaseCandidate">RC</sys:String>
	<sys:String x:Key="String/ApplicationReleasingType.Stable">安定版</sys:String>

	<!-- ApplicationUpdateDialog -->
	<sys:String x:Key="String/ApplicationUpdateDialog.AcceptNonStableApplicationUpdate.Description">これらの設定はアプリケーションオプションからも変更できます。</sys:String>
	<sys:String x:Key="String/ApplicationUpdateDialog.AutoUpdateNotSupported">互換性の問題により、{0} を自動的に更新できません。新しいバージョンを手動でダウンロードしてインストールしてください。現在のバージョンを削除する前に、設定をインポートすることができます。</sys:String>
	<sys:String x:Key="String/ApplicationUpdateDialog.CheckForUpdate">更新を確認</sys:String>
	<sys:String x:Key="String/ApplicationUpdateDialog.CheckingForUpdate">更新を確認しています…</sys:String>
	<sys:String x:Key="String/ApplicationUpdateDialog.DownloadUpdatePackage">ダウンロードしてインストール</sys:String>
	<sys:String x:Key="String/ApplicationUpdateDialog.LatestVersion">{0} は最新の状態です。</sys:String>
	<sys:String x:Key="String/ApplicationUpdateDialog.NewVersionFound">{0} の新しいバージョンが利用可能です: {1}</sys:String>
	<sys:String x:Key="String/ApplicationUpdateDialog.ReleasePage">更新の詳細</sys:String>
	<sys:String x:Key="String/ApplicationUpdateDialog.StartUpdating">更新</sys:String>
	<sys:String x:Key="String/ApplicationUpdateDialog.Title">アプリケーションの更新</sys:String>

	<!-- ApplicationUpdater -->
	<sys:String x:Key="String/ApplicationUpdater.DownloadingAutoUpdater">自動更新コンポーネントをダウンロードしています ({0})…</sys:String>
	<sys:String x:Key="String/ApplicationUpdater.FailedToPrepareForUpdate">更新の準備に失敗しました。</sys:String>
	<sys:String x:Key="String/ApplicationUpdater.FailedToStartAutoUpdater">自動更新を開始できませんでした。</sys:String>
	<sys:String x:Key="String/ApplicationUpdater.PreparingForUpdate">更新を準備しています…</sys:String>
	<sys:String x:Key="String/ApplicationUpdater.ReleasePage">新しいバージョンの変更点</sys:String>

	<!-- AppSuiteApplication -->
	<sys:String x:Key="String/AppSuiteApplication.InitializingComponents">コンポーネントを初期化しています</sys:String>
