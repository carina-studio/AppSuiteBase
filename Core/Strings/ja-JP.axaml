<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:sys="using:System">

	<!-- ApplicationCulture -->
	<sys:String x:Key="String/ApplicationCulture.EN_US">英語（アメリカ合衆国）</sys:String>
	<sys:String x:Key="String/ApplicationCulture.JA_JP">日本語</sys:String>
	<sys:String x:Key="String/ApplicationCulture.System">システム</sys:String>
	<sys:String x:Key="String/ApplicationCulture.ZH_TW">中国語（繁体字）</sys:String>
	<sys:String x:Key="String/ApplicationCulture.ZH_CN">中国語（簡体字）</sys:String>

	<!-- ApplicationDataImportDirectorySelectionDialog -->
	<sys:String x:Key="String/ApplicationDataImportDirectorySelectionDialog.Confirmation">すべての設定とユーザープロファイルを含むアプリケーションデータが、選択したディレクトリ内のデータで上書きされます。上書きした後は元に戻すことはできません。</sys:String>
	<sys:String x:Key="String/ApplicationDataImportDirectorySelectionDialog.DirectoryValidationFailed">ディレクトリ「{0}」には有効なアプリケーションデータが含まれていないようです。それでもこのディレクトリからデータをインポートしますか？</sys:String>
	<sys:String x:Key="String/ApplicationDataImportDirectorySelectionDialog.LocalDirectoriesOnly">ローカルディレクトリのみ使用できます。</sys:String>
	<sys:String x:Key="String/ApplicationDataImportDirectorySelectionDialog.Title">アプリケーションデータのインポート</sys:String>

	<!-- ApplicationInfoDialog -->
	<sys:String x:Key="String/ApplicationInfoDialog.ApplicationChangeList">変更点</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Assemblies">読み込み済みアセンブリ</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Assemblies.Description">{0} 個のアセンブリ</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Attribution.AppIcon.Section1.Flaticon" xml:space="preserve">アプリケーションアイコンは</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Attribution.AppIcon.Section2.Flaticon" xml:space="preserve">が作成し</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Attribution.AppIcon.Section3.Flaticon" xml:space="preserve">で公開しているアイコンを改変したものです。</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Attribution.OpenSourceBased.Section1">は</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Attribution.OpenSourceBased.Section2">オープンソースプロジェクト</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Attribution.OpenSourceBased.Section3">を基に開発されたアプリケーションです。</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Attribution.PoweredBy.Section1">このソフトウェアは</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Attribution.PoweredBy.Section2">および</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Attribution.PoweredBy.Section3">を基盤としています。</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ConfirmRestartingInDebugMode">デバッグモードでは、追加の実行ログが出力され、内部機能を調整するためのオプションが表示されます。次に手動で起動し直すまで、デバッグモードのままになります。</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.CpuUsage">CPU 使用率</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.DeactivateProduct">無効化…</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.DeviceName">デバイス名</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.DonateWithPayPal">PayPal で寄付する</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ExportAppLogs">アプリケーションログのエクスポート…</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ExternalDependencies">外部依存関係…</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.FailedToExportAppLogs">アプリケーションログをエクスポートできませんでした。</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.FinalizationPendingCount">ファイナライズ待ちオブジェクト数</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.FrameworkVersion">.NET バージョン</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.GCFrequency">1 秒あたりのガベージコレクション (GC) 回数</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.GitHubProject">GitHub のプロジェクトページ</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ImportApplicationData">アプリケーションデータのインポート…</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ImportApplicationData.Confirmation">データをインポートするためにアプリケーションを再起動します。</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.InstalledFrameworkVersion">(インストール済み: {0})</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ManagedHeapSize">マネージドヒープサイズ</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ManagedHeapUsage">マネージドヒープ使用量</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.NetworkConnection">ネットワーク</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.NetworkConnection.Disconnected">未接続</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.NetworkConnection.Format">接続済み ({0})</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.OperatingSystem">オペレーティングシステム</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Other">その他の情報</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.PrimaryNetworkInterface">主要ネットワークインターフェイス</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.PrimaryNetworkInterface.Format">{0} ({1})、{2}</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.PrivacyPolicyWasAgreedBefore">「プライバシーポリシー」に同意済みです。</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.PrivateMemoryUsage">プライベートメモリ使用量</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ProcessId">識別子 (PID)</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ProcessInformation">プロセス情報</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ProcessorCount">プロセッサ数</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ProductAuthorizationInfo">{0} に認証されています</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Products">製品</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ProprietaryVersion">(Carina Studio によるビルド)</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.RestartInDebugMode">デバッグモードで再起動</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.RunningScriptCount">実行中のスクリプト数</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Screen.PixelDensity">画面の拡大率</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Screen.Size">画面サイズ</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Screen.WorkingArea">画面の作業領域</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ScriptRunningLoading">スクリプト実行負荷</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ShowAppUpdateDialog">更新を確認…</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.SucceededToExportAppLogs">アプリケーションログをエクスポートしました。</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.SystemInformation">システム情報</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.ThreadCount">スレッド数</sys:String>
	<sys:String x:Key="String/ApplicationInfoDialog.Title">{0} について</sys:String>
